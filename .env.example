# Supabase-project "youcon-website" (Project Settings → API Keys).
# Kopieer naar .env.local; zet dezelfde waarden in Vercel.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Account aanmaken met e-mail/wachtwoord op /lid-worden. Pas op "true" zetten
# als Resend de bevestigingsmails verstuurt (docs/email-login.md).
NEXT_PUBLIC_EMAIL_SIGNUP_ENABLED=
